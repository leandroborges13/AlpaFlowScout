# Copie para .env e preencha. O .env nunca vai para o git.

# Chave do painel da API-Football (dashboard.api-football.com → Account → My Access)
APIFOOTBALL_KEY=
# Limite de consultas por dia (plano Pro: 7.500; deixe folga)
APIFOOTBALL_LIMITE_DIA=7000
# Só o protótipo Node usa: páginas por consulta (gratuito: 3; pago: 99)
APIFOOTBALL_MAX_PAGINAS=99

# Banco PostgreSQL do Scout (o banco é criado na primeira execução)
SCOUT_DB=Host=localhost;Port=5432;Database=alpaflow_scout;Username=postgres;Password=

# Chat com IA
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
