# Copie para /opt/alpaflowscout/.env e preencha. Nunca vai para o git.
DB_PASSWORD=
APIFOOTBALL_KEY=
APIFOOTBALL_LIMITE_DIA=7000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Atualização diária (liga:temporada) e hora de Brasília
SCOUT_ATUALIZAR=71:2026,72:2026,75:2026,73:2026,13:2026,11:2026
SCOUT_ATUALIZAR_HORA=6

# Pós-jogo automático do canal Futebol em Números (vazio = desligado). Atlético-MG = 1062.
SCOUT_POSJOGO_TIMES=1062
# Aviso no WhatsApp pela Evolution API (a mesma do Kazapet); número com 55 e DDD, só dígitos
SCOUT_WHATSAPP_URL=
SCOUT_WHATSAPP_CHAVE=
SCOUT_WHATSAPP_INSTANCIA=
SCOUT_WHATSAPP_NUMERO=
